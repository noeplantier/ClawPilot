# Copy to backend/.env — never commit the real file (it is git-ignored).

# --- Required ---
DATABASE_URL=postgresql+asyncpg://clawpilot:devpassword@localhost:5432/clawpilot
JWT_SECRET=change-me-to-a-long-random-string   # e.g. `openssl rand -hex 32`

# --- Optional: runtime ---
APP_ENV=development                 # "production" disables scripts/seed_demo.py
CORS_ORIGINS=http://localhost:3000  # comma-separated; never "*" with credentials
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- OutreachOS (prospect discovery, dry-run by default) ---
# Sender identity printed in every draft. All four are required to create a draft; there is no default.
OUTREACH_SENDER_NAME=
OUTREACH_SENDER_COMPANY=
OUTREACH_SENDER_ADDRESS=
OUTREACH_SENDER_EMAIL=
# Public API URL, used in the unsubscribe link (https in production). Changing JWT_SECRET breaks old links.
PUBLIC_BASE_URL=http://localhost:8000
# Dangerous capabilities, OFF unless set to true. FEATURE_EXTERNAL_SOURCES lets an import fetch each company's own public
# homepage (robots.txt respected); it never fetches platforms (LinkedIn, Facebook, Google...) or non-public addresses.
# FEATURE_LIVE_SENDING=true sends real e-mail over SMTP (see docs/go-live-email.md; refused unless SMTP_* is complete).
FEATURE_LIVE_SENDING=
FEATURE_EXTERNAL_SOURCES=
# FEATURE_PROSPECT_IMPORT=true lets owners/admins import a CSV/JSON list (origin and legal basis are recorded; preview first).
FEATURE_PROSPECT_IMPORT=
# While live sending is on, only OUTREACH_LIVE_ALLOWLIST (addresses or @domains, comma separated) can receive mail.
# The sandbox stays ON unless you set OUTREACH_SANDBOX=false on purpose. An empty allowlist allows nobody.
OUTREACH_SANDBOX=
OUTREACH_LIVE_ALLOWLIST=
# SMTP (the real channel). All three are required; TLS is mandatory and verified. SMTP_SECURITY: starttls (587) | ssl (465).
# Never commit the password: set it in the hosting dashboard.
SMTP_HOST=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SECURITY=starttls
SMTP_PORT=
# EMERGENCY STOP: SEND_KILL_SWITCH=true refuses every send (dispatch, SMTP test, SendGrid and Twilio). Set it by redeploying.
SEND_KILL_SWITCH=

# --- Optional: integrations (each falls back to a mock when unset) ---
SENDGRID_API_KEY=
# No default sender: without SENDGRID_FROM_EMAIL (a sender verified at SendGrid) the legacy e-mail paths stay in mock.
SENDGRID_FROM_EMAIL=
# Public key of SendGrid's Event Webhook signature (without the PEM header/footer lines).
SENDGRID_WEBHOOK_PUBLIC_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
# Exact public URL configured in the Twilio console for POST /api/webhooks/twilio.
# Required behind a proxy (Render): the signature is computed over this URL.
TWILIO_WEBHOOK_URL=
EMERGENT_LLM_KEY=
