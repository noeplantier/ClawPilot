# Copy to backend/.env — never commit the real file (it is git-ignored).

# --- Required ---
DATABASE_URL=postgresql+asyncpg://clawpilot:devpassword@localhost:5432/clawpilot
JWT_SECRET=change-me-to-a-long-random-string   # e.g. `openssl rand -hex 32`

# --- Optional: runtime ---
APP_ENV=development                 # "production" disables scripts/seed_demo.py
CORS_ORIGINS=http://localhost:3000  # comma-separated; never "*" with credentials
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- Optional: integrations (each falls back to a mock when unset) ---
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
# Exact public URL configured in the Twilio console for POST /api/webhooks/twilio.
# Required behind a proxy (Render): the signature is computed over this URL.
TWILIO_WEBHOOK_URL=
EMERGENT_LLM_KEY=
